{
  "name": "vyune-player",
  "version": "2.0.0",
  "description": "VYUNE \u2014 Feel every frequency.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "bun server/index.js",
    "dev": "bun --watch server/index.js",
    "dev:node": "node --watch server/index.js",
    "dev:web": "bun run --filter=web dev",
    "build": "bun run --filter=web build",
    "test": "bun tests/match.test.mjs && bun tests/search.test.mjs && bun tests/browse-kind.test.mjs && bun tests/lyrics.test.mjs && bun tests/boot.test.mjs",
    "test:lyrics": "bun tests/lyrics.test.mjs",
    "test:e2e": "bun tests/run.mjs",
    "test:boot": "bun tests/boot.test.mjs"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "bgutils-js": "^4.0.3",
    "crypto-js": "^4.2.0",
    "hono": "^4.13.16",
    "jsdom": "^24.1.3",
    "youtubei.js": "^18.3.0"
  },
  "workspaces": [
    "web"
  ],
  "devDependencies": {
    "bun": "^1.4.4",
    "playwright": "^1.64.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "bun@1.4.4": true
  }
}
