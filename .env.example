PORT=3000

# Optional YouTube cookie or PO-token provider for server hosts.
# For dynamic video-bound tokens, run a trusted BgUtils-compatible service and
# set its base URL (the server appends /get_pot). Keep it private; do not expose
# an unauthenticated token generator to the public internet.
YT_COOKIE=
YT_PO_TOKEN_PROVIDER_URL=
# Static client-specific tokens are a fallback; they expire and may be bound
# to a particular client/session/video. Prefer the dynamic provider above.
YT_PO_TOKEN=
YT_PO_TOKEN_VISIONOS=
YT_PO_TOKEN_YTMUSIC=
YT_PO_TOKEN_WEB=
YT_PO_TOKEN_MWEB=



# JioSaavn wrapper (https://github.com/shnwazdev/shnwazdev-jiosaavn-api), asked first for search/details/stream.
# Defaults to the public deployment; point it at your own for reliability. SAAVN_WRAPPER=off skips it.
# SAAVN_WRAPPER_URL=https://jio.shnwaz.dev
# SAAVN_WRAPPER=on
